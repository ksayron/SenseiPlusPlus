SENSEI_POSTGRES_DB=sensei
SENSEI_POSTGRES_USER=sensei
SENSEI_POSTGRES_PASSWORD=sensei_local_dev
SENSEI_POSTGRES_PORT=5432

# Local HTTPS development (scripts/Start-Local.ps1).
SENSEI_BACKEND_URL=https://localhost:7082
Authentication__External__PublicOrigin=https://localhost:5173/
Authentication__External__AllowInsecureLoopback=false

# Google OAuth web application: https://localhost:5173/signin-google
# Fill in both values, then set Enabled=true.
Authentication__External__Google__Enabled=false
Authentication__External__Google__ClientId=
Authentication__External__Google__ClientSecret=

# GitHub OAuth App: https://localhost:5173/signin-github
# Fill in both values, then set Enabled=true.
Authentication__External__GitHub__Enabled=false
Authentication__External__GitHub__ClientId=
Authentication__External__GitHub__ClientSecret=
