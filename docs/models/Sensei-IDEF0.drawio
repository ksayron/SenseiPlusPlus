        <mxCell id="rules-v34" value="Выполнено: два уровня — A-0 содержит один блок A0; A0 раскрывает его шестью блоками A1–A6." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#17212B;fontStyle=0;align=left;verticalAlign=middle;spacing=8;fillColor=none;strokeColor=none;strokeWidth=2;" vertex="1" parent="1">
