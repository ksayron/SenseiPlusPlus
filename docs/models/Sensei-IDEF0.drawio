        </mxCell>
        <mxCell id="rules-v35" value="Выполнено: все 24 требования имеют хотя бы один блок; ни один блок не остаётся без требований." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#17212B;fontStyle=0;align=left;verticalAlign=middle;spacing=8;fillColor=none;strokeColor=none;strokeWidth=2;" vertex="1" parent="1">
