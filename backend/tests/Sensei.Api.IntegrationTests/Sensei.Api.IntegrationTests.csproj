<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Keep native journey dependencies in the selected configuration across solution boundaries. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The test graph resolves OpenIddict's XML/PKCS packages outside the web shared framework. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Sensei.BuildingBlocks.Application\Sensei.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Sensei.BuildingBlocks.Persistence\Sensei.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Modules\Experience\Sensei.Modules.Experience.Domain\Sensei.Modules.Experience.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Sensei.Modules.Identity.Domain\Sensei.Modules.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Learning\Sensei.Modules.Learning.Domain\Sensei.Modules.Learning.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\WorkReflection\Sensei.Modules.WorkReflection.Domain\Sensei.Modules.WorkReflection.Domain.csproj" />
    <ProjectReference Include="..\..\src\Sensei.Host\Sensei.Host.csproj" />
  </ItemGroup>
<ItemGroup><ProjectReference Include="../../../agent-spp/src/Sensei.LocalAgent.Cli/Sensei.LocalAgent.Cli.csproj" /></ItemGroup>
</Project>
